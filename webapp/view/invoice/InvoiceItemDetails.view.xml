<mvc:View
    controllerName="com.eiffage.sdt.controller.InvoiceCreateItem"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout">
    <f:DynamicPage id="pageBillingDocItem" headerExpanded="true">
        <f:title>
          <f:DynamicPageTitle>
            <f:heading>
              <VBox class="sapUiTinyMarginBegin sapUiTinyMarginTopBottom">
                <Title
                  text="{billingDocItemDetail>/SalesOrderItemText}"
                  level="H2" />
                <ObjectIdentifier
                  title="{billingDocItemDetail>/Material}" />
              </VBox>
            </f:heading>
          </f:DynamicPageTitle>
      </f:title>
      <f:header>
        <f:DynamicPageHeader pinnable="true">
          <HBox
            wrap="Wrap"
            renderType="Bare"
            class="sapUiMediumMarginTop sapUiMediumMarginBottom">

            <VBox class="sapUiLargeMarginEnd sapUiMediumMarginBottom">
              <Label text="Billing Document" />
              <Title text="{billingDocItemDetail>/BillingDocument}" level="H2" />
            </VBox>

          <VBox class="sapUiLargeMarginEnd sapUiMediumMarginBottom">
              <Label text="Item" />
              <Title text="{billingDocItemDetail>/SalesOrderItem}" level="H2" />
            </VBox>

            <VBox class="sapUiLargeMarginEnd sapUiMediumMarginBottom">
              <Label text="Net Value" />
              <ObjectNumber
                number="{billingDocItemDetail>/NetAmout}"
                unit="{billingDocItemDetail>/TransactionCurrency}" />
            </VBox>

            <VBox class="sapUiMediumMarginBottom">
              <Label text="Net Value" />
              <ObjectNumber
                number="{billingDocItemDetail>/TaxAmount}"
                unit="{billingDocItemDetail>/TransactionCurrency}"
                emphasized="false"
                state="Information" />
            </VBox>
          </HBox>
        </f:DynamicPageHeader>
      </f:header>
    <f:content>
        <IconTabBar
                    id="idTabBarInvoiceCreateItem"
                    headerMode="Inline"
                    expanded="{device>/isNoPhone}"
                    applyContentPadding="false">
                    <items>
                        <IconTabFilter
                            text="General Information"
                            key="genInfo"
                            id="genInfoInvoiceItem">
                            <content>
                            <core:Fragment
                                fragmentName="com.eiffage.sdt.view.invoice.fragment.item.GeneralInformation"
                                type="XML"/>
                            </content>
                        </IconTabFilter>
                        <IconTabFilter
                            text="Pricing Data"
                            key="pricingData"
                            id="pricingDataItem">
                            <core:Fragment
                                fragmentName="com.eiffage.sdt.view.invoice.fragment.item.PricingData"
                                type="XML"/>
                        </IconTabFilter>
                        <IconTabFilter
                            text="Pricing Elements"
                            key="pricingElements"
                            id="pricingElementsItem">
                            <core:Fragment
                                fragmentName="com.eiffage.sdt.view.invoice.fragment.item.PricingElements"
                                type="XML"/>
                        </IconTabFilter>
                        <IconTabFilter
                            text="Taxes"
                            key="taxes"
                            id="taxesItems">
                            <core:Fragment
                                fragmentName="com.eiffage.sdt.view.invoice.fragment.item.Taxes"
                                type="XML"/>
                        </IconTabFilter>                       
                        <IconTabFilter
                            text="Business Partners"
                            key="partners"
                            id="partnersItem">
                            <core:Fragment
                                    fragmentName="com.eiffage.sdt.view.invoice.fragment.item.Partners"
                                    type="XML"/>
                        </IconTabFilter>
                        <IconTabFilter
                            text="Accounting Data"
                            key="accountingData"
                            id="accountingDataItem">
                            <core:Fragment
                                fragmentName="com.eiffage.sdt.view.invoice.fragment.item.AccountingData"
                                type="XML"/>
                        </IconTabFilter>
                        <IconTabFilter
                            text="Texts"
                            key="texts"
                            id="textsInvoiceItem">
                            <core:Fragment
                                fragmentName="com.eiffage.sdt.view.invoice.fragment.item.TextTable"
                                type="XML"/>
                        </IconTabFilter>
                        <IconTabFilter
                            text="Sales Order Data"
                            key="soData"
                            id="soDataItem">
                            <core:Fragment
                                fragmentName="com.eiffage.sdt.view.invoice.fragment.item.SalesOrderData"
                                type="XML"/>
                        </IconTabFilter>
                    </items>
                </IconTabBar>
                </f:content>
        <f:footer>
        </f:footer>
    </f:DynamicPage>
</mvc:View>