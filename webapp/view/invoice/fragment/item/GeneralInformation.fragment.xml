                        <Label text="Sales Doc. Item Cat."/>
                        <Text text="{billingDocItemDetail>/SalesOrderItemCategory}"/>
                           
                        <Label text="Ref. Doc. Category"/>
                        <Text text="{billingDocItemDetail>/SalesOrderType}"/>

                        <Label text="Reference Document"/>
                        <Text text="{billingDocItemDetail>/SalesOrder}"/>

                        <Label text="Reference Item"/>
                        <Text text="{billingDocItemDetail>/SalesOrderItem}"/>

                        <core:Title text="Additional Data"/>

                        <Label text="Plant"/>
                        <Text text="{billingDocItemDetail>/ProductionPlant}"/>

                        <Label text="Division"/>
