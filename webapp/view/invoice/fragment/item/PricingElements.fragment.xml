<core:FragmentDefinition xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form"
    xmlns:l="sap.ui.layout">

        <Table
            id="tablePriceElementsDisplayItemInvoice"
            items="{billingDocItemDetail>/to_PricingElement}"
            mode="None">
            <headerToolbar>
			    <OverflowToolbar>
				    <content>
					    <Title text="Pricing Elements" level="H2"/>
                    </content>
                </OverflowToolbar>
            </headerToolbar>
            <columns>
                <Column>
                    <Text text="Condition Type" />
                </Column>
                <Column>
                    <Text text="Description" />
                </Column>
                <Column>
                    <Text text="Amount" />
                </Column>
                <Column>
                    <Text text="Currency" />
                </Column>
                <Column>
                    <Text text="Pricing Unit" />
                </Column>
                <Column>
                    <Text text="Condition Unit" />
                </Column>
                <Column>
                    <Text text="Condition Basis" />
                </Column>
                <Column>
                    <Text text="Condition Base Unit" />
                </Column>
                <Column>
                    <Text text="Condition Value" />
                </Column>
                <Column>
                    <Text text="Document Currency"/>
                </Column>
                <Column>
                    <Text text="Changed Manually" />
                </Column>
            </columns>

            <items>
                <ColumnListItem>
                    <cells>
                        <Text text="{billingDocItemDetail>ConditionType}" />
                        <Text text="{billingDocItemDetail>ConditionTypeName}" />
                        <Text text="{ path: 'billingDocItemDetail>ConditionRateValue', type: 'sap.ui.model.type.Float', formatOptions: {minFractionDigits: 2,maxFractionDigits: 2,preserveDecimals: false}}" />
                        <Text text="{billingDocItemDetail>ConditionCurrency}" />
                        <Text text="{billingDocItemDetail>ConditionPricingUnit}"/>
                        <Text text="{billingDocItemDetail>ConditionQuantityUnit}"/>
                        <Text text="{}" />
                        <Text  text="{ path: 'billingDocItemDetail>ConditionAmount', type: 'sap.ui.model.type.Float', formatOptions: {minFractionDigits: 2,maxFractionDigits: 2,preserveDecimals: false}}" />
                        <Text text="{}" />
                        <Text text="{billingDocItemDetail>TransactionCurrency}" />
                        <Text text="{= ${billingDocItemDetail>ConditionIsManuallyChanged} ? 'Yes' : ''}" />
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
</core:FragmentDefinition>