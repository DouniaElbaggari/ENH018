<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form">

    <Dialog
        id="rejectionReasonDialog"
        title="Set Rejection Reason"
        contentWidth="32rem"
        draggable="true"
        resizable="false"
        afterClose="">

        <content>
            <VBox class="sapUiSmallMargin">
                <Label text="Rejection Reason" required="true" labelFor="rejectionReasonSelect" />

                <Select
                    id="rejectionReasonSelect"
                    width="100%"
                    selectedKey="{itemDetail>/SalesDocumentRjcnReason}"
                    items="{rejectionReasonVH>/I_SalesDocAllowedRjcnRsn}"
                    forceSelection="true"
                    change="">
                    <core:Item
                        key="{rejectionReasonVH>SalesDocumentRjcnReason}"
                        text="{rejectionReasonVH>SalesDocumentRjcnReason_Text} ({rejectionReasonVH>SalesDocumentRjcnReason})" />
                </Select>
            </VBox>
        </content>

        <beginButton>
            <Button
                text="Set Rejection Reason"
                type="Emphasized"
                press=".onSetRejectionReasonPress" />
        </beginButton>

        <endButton>
            <Button
                text="Cancel"
                press=".onCancelRejectionReasonPress" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>