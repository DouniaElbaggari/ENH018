<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:fb="sap.ui.comp.filterbar">   
    <fb:FilterBar
                        id="filterBar"
                        persistencyKey="myPersKey"
                        useToolbar="false"
                        search=".onSearch"
                        filterChange=".onFilterChange"
                        afterVariantLoad=".onAfterVariantLoad">
                        <fb:filterGroupItems>
                            <fb:FilterGroupItem
                                name="SalesOrder"
                                label="Sales Order"
                                groupName="Group1"
                                visibleInFilterBar="true">
                                <fb:control>
                                    <MultiInput
                                        id="salesOrderMultiInput"
                                        width="100%"
                                        placeholder=""
                                        showValueHelp="true"
                                        valueHelpRequest=".onSalesOrderVH"
                                        tokenUpdate="onTokenUpdate"
                                        maxTokens="10"/>
                                </fb:control>
                            </fb:FilterGroupItem>
                            <fb:FilterGroupItem
                                name="SalesOrderType"
                                label="Sales Order Type"
                                groupName="Group1"
                                visibleInFilterBar="true">
                                <fb:control>
                                    <MultiInput
                                        id="documentTypeMultiInput"
                                        width="100%"
                                        placeholder=""
                                        showValueHelp="true"
                                        valueHelpRequest=".onDocumentTypeVH"
                                        tokenUpdate="onTokenUpdate"
                                        maxTokens="10"/>
                                </fb:control>
                            </fb:FilterGroupItem>
                            <fb:FilterGroupItem
                                name="SoldToParty"
                                label="Sold-to Party"
                                groupName="Group1"
                                visibleInFilterBar="true">
                                <fb:control>
                                    <MultiInput
                                        id="soldToMultiInput"
                                        width="100%"
                                        placeholder=""
                                        showValueHelp="true"
                                        valueHelpRequest=".onSoldToVH"
                                        tokenUpdate="onTokenUpdate"
                                        maxTokens="10"/>
                                </fb:control>
                            </fb:FilterGroupItem>
                            <fb:FilterGroupItem
                                name="PurchaseOrderByCustomer"
                                label="Customer Reference"
                                groupName="Group1"
                                visibleInFilterBar="true">
                                <fb:control>
                                    <MultiInput
                                        id="custRefMultiInput"
                                        width="100%"
                                        placeholder=""
                                        showValueHelp="true"
                                        valueHelpRequest=".onCustRefVH"
                                        tokenUpdate="onTokenUpdate"
                                        maxTokens="10"/>
                                </fb:control>
                            </fb:FilterGroupItem>
                            <fb:FilterGroupItem
                                name="RequestedDeliveryDate"
                                label="Requester Delivery Date"
                                groupName="Group1"
                                visibleInFilterBar="true">
                                <fb:control>
                                    <DatePicker></DatePicker>
                                </fb:control>
                            </fb:FilterGroupItem>
                            <!--<fb:FilterGroupItem
                                name="OverallSDProcessStatus"
                                label="Overall Status"
                                groupName="Group1"
                                visibleInFilterBar="true">
                                <fb:control>
                                    <MultiComboBox
                                        id="statusMultiComboBox"
                                        width="100%"
                                        placeholder=""
                                        selectionFinish=""
                                        selectionChange=""
                                        selectedKeys="{salesOrder>/overallStatus}"
                                        items="{overallStatusVH>/I_OverallSDProcessStatus}">
                                        <core:Item
                                            key="{overallStatusVH>OverallSDProcessStatus}"
                                            text="{overallStatusVH>OverallSDProcessStatus_Text}" />
                                    </MultiComboBox>
                                </fb:control>
                            </fb:FilterGroupItem>-->
                            <fb:FilterGroupItem
                                name="SalesOrderDate"
                                label="Document Date"
                                groupName="Group1"
                                visibleInFilterBar="true">
                                <fb:control>
                                    <DatePicker></DatePicker>
                                </fb:control>
                            </fb:FilterGroupItem>
                            <fb:FilterGroupItem
                                name="SalesOrganizationForFilter"
                                label="Sales Organization"
                                groupName="Group1"
                                visibleInFilterBar="true">
                                <fb:control>
                                    <MultiInput
                                        id="multiInSalesOrg"
                                        width="100%"
                                        placeholder=""
                                        showValueHelp="true"
                                        valueHelpRequest=".onSalesOrgVH"
                                        tokenUpdate="onTokenUpdate"
                                        maxTokens="10"/>
                                </fb:control>
                            </fb:FilterGroupItem>
                            <fb:FilterGroupItem
                                name="DistributionChannel"
                                label="Distribution Channel"
                                groupName="Group1"
                                visibleInFilterBar="true">
                                <fb:control>
                                    <MultiInput
                                        id="multiInDistChannel"
                                        width="100%"
                                        placeholder=""
                                        showValueHelp="true"
                                        valueHelpRequest=".onDistrChannelVH"
                                        tokenUpdate="onTokenUpdate"
                                        maxTokens="10"/>
                                </fb:control>
                            </fb:FilterGroupItem>
                            <fb:FilterGroupItem
                                name="OrganizationDivision"
                                label="Division"
                                groupName="Group1"
                                visibleInFilterBar="true">
                                <fb:control>
                                    <MultiInput
                                        id="multiInDivition"
                                        width="100%"
                                        placeholder=""
                                        showValueHelp="true"
                                        valueHelpRequest=".onDivisionVH"
                                        tokenUpdate="onTokenUpdate"
                                        maxTokens="10"/>
                                </fb:control>
                            </fb:FilterGroupItem>
                            <fb:FilterGroupItem
                                name="CreatedByUser"
                                label="Created By"
                                groupName="Group1"
                                visibleInFilterBar="true">
                                <fb:control>
                                    <MultiInput
                                        id="multiInCreatedBy"
                                        width="100%"
                                        placeholder=""
                                        showValueHelp="true"
                                        valueHelpRequest=".onCreatedBy"
                                        tokenUpdate="onTokenUpdate"
                                        maxTokens="10"/>
                                </fb:control>
                            </fb:FilterGroupItem>
                        </fb:filterGroupItems>
                    </fb:FilterBar>
                    </core:FragmentDefinition>