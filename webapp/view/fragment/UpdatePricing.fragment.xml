<core:FragmentDefinition
    controllerName="com.eiffage.sdt.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form">

    <Dialog
        id="updatePricingTypeDialog"
        title="Update Prices"
        contentWidth="40rem"
        class="sapUiContentPadding customCreateDialog"
        draggable="true"
        resizable="false">

        <content>
            <f:SimpleForm
                editable="true"
                layout="ResponsiveGridLayout"
                labelSpanXL="12"
                labelSpanL="12"
                labelSpanM="12"
                labelSpanS="12"
                adjustLabelSpan="false"
                emptySpanXL="0"
                emptySpanL="0"
                emptySpanM="0"
                emptySpanS="0"
                columnsXL="1"
                columnsL="1"
                columnsM="1"
                singleContainerFullSize="true">

                <Label text="Pricing Type" required="true" />
                <Select
                    id="selPricingType"
                    width="100%"
                    selectedKey="{salesOrder>/SalesOrderType}"
                    items="{salesOrderTypeVH>/C_SalesOrderTypeManageVH}">
                    <core:Item
                        key="{salesOrderTypeVH>SalesOrderType}"
                        text="{salesOrderTypeVH>SalesOrderType_Text} ({salesOrderTypeVH>SalesOrderType})" />
                </Select>
            </f:SimpleForm>
        </content>

        <beginButton>
            <Button
                text="Update Prices"
                type="Emphasized"
                press=".onCreateSalesOrder" />
        </beginButton>

        <endButton>
            <Button
                text="Cancel"
                press=".onCloseCreateDialog" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>