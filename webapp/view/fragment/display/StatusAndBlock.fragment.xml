            <form:content>
                <core:Title text="Processing Status" />

                <!--<Label text="Delivery Status" />
                <Text text="" />-->

                <Label text="Order-Related Billing Status" />
                <Text text=""/>

                <Label text="Rejection Status" />
                <Text text=""/>

                <Label text="Reason for Rejection" />
                <Text text=""/>

                <Label text="User Status" />
                <Text text="{viewModel>/userStatusDescription}"/>

                <core:Title text="Block Status" />

                <!--<Label text="Delivery Block Status" />
                <Text text="{/CustomerReference}" />-->

                <Label text="Billing Block Status" />
                <Text text="{/CustomerReference}" />

                <Label text="Billing Block" />
                <Text text="{/CustomerReference}" />

                <core:Title text="Completion Status" />

                <Label text="Incompletion Status" />
                <Text text="" />

                <!--<core:Title text="Prodict Compliance Status" />

                <Label text="Product Marketability Status" />
                <Text text="" />

                <Label text="Dangerous Goods Status" />
                <Text text="" />

                <Label text="Safety Data Sheet Status" />
                <Text text="" />-->
            </form:content>
        
        </form:SimpleForm>
        
        </VBox>
        </HBox>
     </VBox>
</core:FragmentDefinition>