<core:FragmentDefinition xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form"
    xmlns:l="sap.ui.layout"
    xmlns:table="sap.ui.table">
    <VBox class="sapUiResponsiveContentPadding sapUiSmallMarginTop">

        <HBox class="sapUiMediumMarginBottom">
            <VBox width="100%">
                <form:SimpleForm id="basicDataSimpleFormItemDisplay" editable="true" layout="ResponsiveGridLayout" title="Basic Data" labelSpanXL="12" labelSpanL="12" labelSpanM="12" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="3" columnsXL="3" columnsL="3" columnsM="3" singleContainerFullSize="false">
                    <form:content>
                        <core:Title text="Item Data"/>
                        <Label text="Item Category"/>
                        <Text text="{itemDetail>/SalesOrderItemCategory}"/>

                        <Label text="Customer Reference"/>
                        <Text text="{itemDetail>/PurchaseOrderByCustomer}"/>

                        <Label text="Customer Material"/>
                        <Text text="{itemDetail>/MaterialByCustomer}"/>

                        <core:Title text="Terms and Conditions"/>

                        <Label text="Incoterms"/>
                        <Text text="{itemDetail>/IncotermsClassification}"/>
                        
                        <core:Title text="Shipping"/>

                        <Label text="Plant"/>
                        <Text text="{itemDetail>/ProductionPlant}"/>

                    </form:content>
                </form:SimpleForm>
            </VBox>
        </HBox>

        <form:SimpleForm id="advancedDataSimpleFormItemDisplay" title="Advanced Data" editable="true" layout="ResponsiveGridLayout" labelSpanXL="12" labelSpanL="12" labelSpanM="12" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="1" emptySpanL="1" emptySpanM="0" emptySpanS="0" columnsXL="3" columnsL="3" columnsM="2" singleContainerFullSize="false">

            <form:content>
                <core:Title text="Account Assignment"/>

                <Label text="Profit Center"/>
                <Text text="{itemDetail>/ProfitCenter}"/>

                <Label text="WBS Element"/>
                <Text text="{itemDetail>/WBSElement}"/>

                <Label text="Acct Assmt Grp Mat."/>
                <Text text="{itemDetail>/MatlAccountAssignmentGroup}"/>

                <core:Title text="Dates"/>

                <Label text="Billing Date"/>
                <Text text="{path: 'itemDetail>/BillingDocumentDate', formatter: '.formatter.formatDocumentDate'}"/>

                <Label text="Pricing Date"/>
                <Text text="{path: 'itemDetail>/PricingDate', formatter: '.formatter.formatDocumentDate'}"/>
             </form:content>
        </form:SimpleForm>
    </VBox>
</core:FragmentDefinition>