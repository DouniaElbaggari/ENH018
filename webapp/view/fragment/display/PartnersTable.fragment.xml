<core:FragmentDefinition
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form"
    xmlns:l="sap.ui.layout"
    xmlns:table="sap.ui.table">
    
    <Panel headerText="Partners" class="sapUiSmallMarginTop">
        <Table id="partnersTableDisplayItem" items="{itemDetail>/to_Partner}" width="100%">
                <columns>
                    <Column width="10rem">
                        <Label text="Partner Function"/>
                    </Column>
                    <Column width="16rem">
                        <Label text="Partner"/>
                    </Column>
                    <Column width="16rem">
                        <Label text="Address"/>
                    </Column>
                    <Column width="12rem">
                        
                    </Column>
                </columns>

                <items>
                    <ColumnListItem >
                        <cells>
                            <Text text="{itemDetail>PartnerFunction}"/>
                            <Text text="{itemDetail>to_Address/FullName} ({itemDetail>Customer})"/>
                            <Text text="{itemDetail>to_Address/StreetName}, {itemDetail>to_Address/PostalCode}, {itemDetail>to_Address/CityName}, {itemDetail>to_Address/Country}"/>
                            <Link text="Details" press=".onBPAddressDetailPress"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
    </Panel>
</core:FragmentDefinition>