<core:FragmentDefinition
    controllerName="com.eiffage.sdt.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form">

    <Dialog
        id="copyCOntractSelectionDialog"
        title="Create from Contract"
        contentWidth="30rem"
        class="sapUiContentPadding customCreateDialog"
        draggable="true"
        resizable="false">

        <content>
            <f:SimpleForm
                editable="true"
                layout="ResponsiveGridLayout"
                labelSpanXL="12"
                labelSpanL="12"
                labelSpanM="12"
                labelSpanS="12"
                adjustLabelSpan="false"
                emptySpanXL="0"
                emptySpanL="0"
                emptySpanM="0"
                emptySpanS="0"
                columnsXL="1"
                columnsL="1"
                columnsM="1"
                singleContainerFullSize="true">
                <Label text="Sales Contract" required="true"/>
                <Input
                    id="inSalesContract"
                    value="{viewModel>/salesContract}"
                    showValueHelp="true"
                    valueHelpRequest=".onSalesContractVH"
                    width="100%" />
                <Label text="Sales Order Type" required="true" />
                <Select
                    id="soTypeSelect"
                    width="100%"
                    selectedKey="{viewModel>/salesOrderType}"
                    items="{salesOrderTypeVH>/C_SalesOrderTypeManageVH}">
                    <core:Item
                        key="{salesOrderTypeVH>SalesOrderType}"
                        text="{salesOrderTypeVH>SalesOrderType_Text} ({salesOrderTypeVH>SalesOrderType})" />
                </Select>
            </f:SimpleForm>
        </content>

        <beginButton>
            <Button
                text="Create from Contract"
                type="Emphasized"
                press=".onCreateFromSalesContract" />
        </beginButton>

        <endButton>
            <Button
                text="Cancel"
                press=".onCloseSalesContractDialog" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>