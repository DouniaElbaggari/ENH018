<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core">

  <Dialog
    id="createConditionDialog"
    title="Create"
    type="Message"
    contentWidth="36rem"
    draggable="true"
    resizable="false">

    <content>
      <VBox class="sapUiSmallMargin">
        <Label
          text="Condition Type:"
          required="true"
          labelFor="conditionTypeInput" />

        <Input
          id="conditionTypeInput"
          value="{view>/conditionType}"
          width="100%"
          showValueHelp="true"
          valueHelpRequest=".onConditionTypeValueHelp"
          submit=".onCreateCondition" />
      </VBox>
    </content>

    <beginButton>
      <Button
        text="Create"
        type="Emphasized"
        press=".onCreateCondition" />
    </beginButton>

    <endButton>
      <Button
        text="Cancel"
        press=".onCancelCreateDialog" />
    </endButton>

  </Dialog>
</core:FragmentDefinition>