            <form:SimpleForm id="advancedDataSimpleForm" editable="true" layout="ResponsiveGridLayout" title="Advanced Data" labelSpanXL="12" labelSpanL="12" labelSpanM="12" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="1" emptySpanL="1" emptySpanM="0" emptySpanS="0" columnsXL="3" columnsL="3" columnsM="2" singleContainerFullSize="false">

                <form:content>
                    <core:Title text="Organizational Data"/>

                    <Label text="Sales Organization"/>
                    <Text text="{descriptions>/salesOrgDescription}" />

                    <Label text="Distribution Channel"/>
                    <Text text="{descriptions>/distChannelName}" />

                    <Label text="Division"/>
                    <Text text="{descriptions>/divisionName}"/>

                    <core:Title text="Administrative Data"/>

                    <Label text="Created By"/>
                    <Text text="{salesOrder>/CreatedByUser}" />

                    <Label text="Create4d On"/>
                    <Text text="{path: 'salesOrder>/CreationDate', formatter: '.formatter.formatDocumentDate'}"/>

                    <Label text="Last Changed By"/>
                    <Text text="" />

                    <Label text="Last Changed On"/>
                    <Text text="{path: 'salesOrder>/LastChangeDate', formatter: '.formatter.formatDocumentDate'}"/>
            </form:content>
        </form:SimpleForm>

