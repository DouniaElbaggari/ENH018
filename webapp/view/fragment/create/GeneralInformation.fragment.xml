        <Table id="partnersTable" items="{salesOrder>/to_Partner}" width="100%">
            <columns>
                <Column width="10rem">
                    <Label text="Partner Function"/>
                </Column>
                <Column width="16rem">
                    <Label text="Partner"/>
                </Column>
                <Column width="16rem">
                    <Label text="Address"/>
                </Column>
                <Column width="12rem">
                    
                </Column>
            </columns>

            <items>
                <ColumnListItem >
                    <cells>
                        <Text text="{salesOrder>PartnerFunction}"/>
                        <Text text="{salesOrder>to_Address/FullName} ({salesOrder>Customer})"/>
                        <Text text="{salesOrder>to_Address/StreetName}, {salesOrder>to_Address/PostalCode}, {salesOrder>to_Address/CityName}, {salesOrder>to_Address/Country}"/>
                        <Link text="Details" press=".onBPAddressDetailPress"/>
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
    </VBox>
</core:FragmentDefinition>