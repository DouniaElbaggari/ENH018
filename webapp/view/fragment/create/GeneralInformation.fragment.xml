<core:FragmentDefinition xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form"
    xmlns:l="sap.ui.layout"
    xmlns:table="sap.ui.table">
    <VBox class="sapUiResponsiveContentPadding" width="100%">

        <!-- BASIC DATA -->
        <Title text="" level="H3" class="sapUiSmallMarginBottom"/>

        <HBox class="sapUiMediumMarginBottom">
            <!-- Left -->
            <VBox width="100%">
                <form:SimpleForm id="basicDataSimpleForm" editable="true" layout="ResponsiveGridLayout" title="Basic Data" labelSpanXL="12" labelSpanL="12" labelSpanM="12" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="3" columnsXL="3" columnsL="3" columnsM="2" singleContainerFullSize="false">

                    <form:content>
                        <core:Title text="Order Data"/>
                        <Label text="Sold-to Party" required="true"/>
                        <Input id="inSoldTo"
                            value="{salesOrder>/SoldToParty}"
                            showValueHelp="true"
                            valueHelpRequest=".onSoldToVH"
                            showSuggestion="true"
                            startSuggestion="2"
                            filterSuggests="false"
                            suggest=".onSoldToSuggest"
                            suggestionItems="{
                                path: 'soldToVH>/C_SoldToSalesAreaVH',
                                parameters: {
                                    $select: 'Customer,CustomerName'
                                }
                            }">

                            <suggestionItems>
                                <core:ListItem
                                    key="{soldToVH>Customer}"
                                    text="{soldToVH>Customer}"
                                    additionalText="{soldToVH>CustomerName}" />
                            </suggestionItems>
                        </Input>
                        <Label text="Document Date"/>
                        <DatePicker id="dpDocDate" value="{path: 'salesOrder>/BillingDocumentDate', type:'sap.ui.model.type.Date', formatOptions: {
							style: 'medium',
							strictParsing: true
						}}"/>

                        <!-- <Label text="Customer Group"/>
                        <Input id="inCustGrp" value="{salesOrder>/salesOrderHeader/customerGroupName}" showValueHelp="true" valueHelpRequest=".onCustGrpVH"/> -->

                        <core:Title text=" "/>

                        <Label text="Customer Reference"/>
                        <Input value="{salesOrder>/PurchaseOrderByCustomer}"/>

                        <!--<Label text="{i18n>salesOrderHeader.orderData.progressStatus}"/>
                        <Input value="{salesOrder>/OverallSDDocReferenceStatus}"/>-->

                        <Label text="{i18n>salesOrderHeader.basicdata.CustRefDate}"/>
                        <DatePicker id="dpCustRefDate" value="{path: 'salesOrder>/CustomerPurchaseOrderDate', type:'sap.ui.model.type.Date', formatOptions: {
							style: 'medium',
							strictParsing: true
						}}"/>
                        
                        <Label text="Order Reason"/>
                        <Select selectedKey="{salesOrder>/SDDocumentReason}" items="{orderReasonVH>/C_SlsDocAllowedOrderReasonVH}" forceSelection="false">
                            <core:Item key="{orderReasonVH>SDDocumentReason}" text="{orderReasonVH>SDDocumentReasonText} ({orderReasonVH>SDDocumentReason})"/>
                        </Select>

                        <core:Title text=" "/>

                        <!-- <Label text="Shipping Conditions"/>
                        <Input value="{/ShippingConditions}" showValueHelp="true"/>

                        <Label text="Requested Delivery Date"/>
                        <DatePicker value="{/RequestedDeliveryDate}" displayFormat="dd.MM.yyyy" valueFormat="yyyy-MM-dd"/> -->
                    </form:content>
                </form:SimpleForm>
            </VBox>

            <!-- Right -->
            <!--<VBox width="28%">
                <HBox justifyContent="SpaceBetween" alignItems="Center">
