<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
        <Table
            id="userStatusTable"
            mode="SingleSelectLeft"
            includeItemInSelection="true"
            items="{userStatuses>/results}">

            <columns>
                <Column width="5rem">
                    <Text text="Status" />
                </Column>
                <Column>
                    <Text text="Text" />
                </Column>
                <Column width="4rem" hAlign="End">
                    <Text text="No." />
                </Column>
            </columns>

            <items>
                <ColumnListItem selected="{userStatuses>CurrentStatus}">
                    <cells>
                        <Text text="{userStatuses>Status}" />
                        <Text text="{userStatuses>StatusDescription}" />
                        <Text text="{userStatuses>StatusOrder}" />
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
</core:FragmentDefinition>