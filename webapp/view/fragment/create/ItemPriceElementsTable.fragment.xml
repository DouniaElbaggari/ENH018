<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form">

    <VBox>
        <form:SimpleForm
            id="itemPricingData"
            editable="false"
            layout="ResponsiveGridLayout"
            labelSpanXL="3"
            labelSpanL="3"
            labelSpanM="4"
            labelSpanS="12"
            emptySpanXL="4"
            emptySpanL="4"
            emptySpanM="1"
            emptySpanS="0"
            columnsXL="1"
            columnsL="1"
            columnsM="1"
            singleContainerFullSize="true">

            <form:content>
                <Label text="Pricing Date" />
                <Text
                    text="{
                        path: 'itemDetail>/PricingDate',
                        formatter: '.formatter.formatDocumentDate'
                    }" />

                <Label text="Requested Quantity" />
                <ObjectNumber
                    number="{itemDetail>/RequestedQuantity}"
                    unit="{itemDetail>/RequestedQuantityUnit}" />

                <Label text="Tax Amount" />
                <ObjectNumber
                    number="{path: 'itemDetail>/TaxAmount', type: 'sap.ui.model.type.Float', formatOptions: { groupingEnabled: true, groupingSize: 3, groupingSeparator: '.', decimalSeparator: ',', minFractionDigits: 2, maxFractionDigits: 2 }}"
                    unit="{itemDetail>/TransactionCurrency}" />
            </form:content>
        </form:SimpleForm>
        
        <Table
            id="tableItemPriceElementsCreate"
            items="{itemDetail>/to_PricingElement}"
            mode="MultiSelect"
            selectionChange=".onItemSelected">
            
            <headerToolbar>
                <OverflowToolbar>
                    <Title text="Pricing Elements" level="H2"/>
                    <ToolbarSpacer />
                        <Button id="btnAddCondition" icon="sap-icon://add" type="Transparent" press=".onCreatePricingElement" tooltip="Add new condition type"/>
                        <Button id="btnDeleteCondition" icon="sap-icon://delete" type="Transparent" press=".onDeletePricingElement" tooltip="Delete selected condition(s) type"/>
                </OverflowToolbar>
            </headerToolbar>

            <columns>

                <Column width="2em" />
                <Column>
                    <Text text="Condition Type" />
                </Column>
                <Column>
                    <Text text="Description" />
                </Column>
                <Column>
                    <Text text="Condition Amount or Ratio" />
                </Column>
                <Column>
                    <Text text="Pricing Unit" />
                </Column>
                <Column>
                    <Text text="Condition Value" />
                </Column>
                <Column>
                    <Text text="Statistical"/>
                </Column>
            </columns>

            <items>
                <ColumnListItem>
                    <cells>
                        <core:Icon src="{= ${itemDetail>ConditionInactiveReason} === '' ? 'sap-icon://color-fill' : 'sap-icon://project-definition-triangle-2' }" color="{= ${itemDetail>ConditionInactiveReason} === '' ? 'Positive' : '#E9730C' }" />
                        <Text text="{itemDetail>ConditionType}" />
                        <Text text="{itemDetail>ConditionTypeName}" />
                        <HBox>
                            <Input 
                                value="{ path: 'itemDetail>ConditionRateValue', type: 'sap.ui.model.odata.type.Decimal',constraints: {scale: 2}}"
                                enabled="{=${itemDetail>ConditionClass} !== 'D' &amp;&amp; ${itemDetail>ConditionType} !== '' &amp;&amp; ( ${itemDetail>ConditionType} !== 'PR00' || !${viewModel>/isSigned} || ${viewModel>/isNewItem})}"
                                change=".onConditionValueChange"/>
                            <Text text="%" visible="{= ${itemDetail>ConditionCalculationType} === 'A' }"/>
                        </HBox>
                        <HBox>
                            <Input value="{itemDetail>ConditionQuantity}" type="Number" enabled="{= ${itemDetail>ConditionType} === 'PR00' &amp;&amp; ${viewModel>/isSigned} === false }" change=".onConditionQtyChange"/>
                            <Input value="{itemDetail>ConditionQuantityUnit}" enabled="{= ${itemDetail>ConditionType} === 'PR00' &amp;&amp; ${viewModel>/isSigned} === false }"/>
                        </HBox>
                        <HBox>
                            <Text class="sapUiSmallMarginEnd" text="{ path: 'itemDetail>ConditionAmount', type: 'sap.ui.model.type.Float', formatOptions: {minFractionDigits: 2,maxFractionDigits: 2,preserveDecimals: false}}" />
                            <Text text="{itemDetail>TransactionCurrency}" />
                        </HBox>
                        <Text text="{= ${itemDetail>ConditionIsForStatistics} ? 'Yes' : '' }" />
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
    </VBox>
</core:FragmentDefinition>
