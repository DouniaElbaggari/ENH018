<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
  <Table 
    id="tableItemTextCreate" 
    items="{itemDetail>/to_Text}" 
    mode="SingleSelectLeft" 
    alternateRowColors="true" 
    sticky="ColumnHeaders"
    itemActionCount="1"
		itemActionPress=".onItemTextDelete">

    <headerToolbar>
      <OverflowToolbar>
        <Title text="{i18n>salesOrderItemText.table.title}" level="H2"/>
        <ToolbarSpacer/>
        <Button  id="btnAddItemText" icon="sap-icon://add" press=".onAddItemText"/>
        <Button  id="btnDeleteItemText" icon="sap-icon://delete" press=".onItemTextDelete"/>
      </OverflowToolbar>
    </headerToolbar>

    <columns>
      <Column>
        <Text text="{i18n>salesOrderItemText.table.column.textId}"/>
      </Column>
      <Column>
        <Text text="{i18n>salesOrderItemText.table.column.language}"/>
      </Column>
      <Column>
        <Text text="{i18n>salesOrderItemText.table.column.longText}"/>
      </Column>
    </columns>

    <items>
      <ColumnListItem  visible="{= ${itemDetail>isDeleted} !== true }">
        <!--<actions>
				  <ListItemAction type="Delete" />
			  </actions>-->
        <cells>
          <Select items="{itemTextTypes>/textTypes}" selectedKey="{itemDetail>LongTextID}" forceSelection="false" change=".onTextTypeSelection">
            <core:Item key="{itemTextTypes>LongTextID}" text="{itemTextTypes>LongTextIDText} ({itemTextTypes>LongTextID})"/>
          </Select>
          <Input showValueHelp="true" value="{itemDetail>Language}" valueHelpRequest=".onLanguageVH"/>
          <TextArea value="{itemDetail>LongText}" rows="3" width="100%" growing="true" change=".onTextChange"/>
        </cells>
      </ColumnListItem>
    </items>

  </Table>

</core:FragmentDefinition>