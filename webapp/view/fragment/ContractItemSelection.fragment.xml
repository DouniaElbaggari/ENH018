<core:FragmentDefinition
    controllerName="com.eiffage.sdt.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form">
    <Dialog
        id="contractOtemSelection"
        title="{i18n>contractItemSelection.title}"
        contentWidth="80rem"
        class="sapUiContentPadding"
        draggable="true"
        resizable="true">

        <content>
        <Table
            id="contractItemSelection"
            mode="MultiSelect"
            growing="true"
            growingScrollToLoad="true"
            items="{contractItem>/results}">
            <headerToolbar>
                <Toolbar>
                    <Title text="Select Items to be copied" />
                        <ToolbarSpacer />
                        <SearchField
                            width="80%"
                            placeholder="Search items"
                            search=".onSearchContractItems"
                            liveChange=".onSearchContractItems" />
                    </Toolbar>
            </headerToolbar>
            <columns>
                <Column>
                    <Text text="{i18n>contractItemSelection.table.column.contractItemNo}" />
                </Column>

                <Column>
                    <Text text="{i18n>contractItemSelection.table.column.contractMaterialNo}" />
                </Column>

                <Column>
                    <Text text="{i18n>contractItemSelection.table.column.contractMaterialDescription}" />
                </Column>
                <Column>
                    <Text text="{i18n>contractItemSelection.table.column.contractMaterialLongText}" />
                </Column>
            </columns>

            <items>
                <ColumnListItem>
                    <cells>
                        <Text text="{contractItem>SalesContractItem}" />
                        <Text text="{contractItem>Material}"/>
                        <Text text="{contractItem>SalesContractItemText}" />
                        <ExpandableText text="{contractItem>LongText}" />
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
    </content>

    <beginButton>
        <Button
            text="Apply"
            type="Emphasized"
            press=".onApplyContractItemSelection" />
    </beginButton>

    <endButton>
        <Button
            text="Cancel"
            press=".onCloseContractItemDialog" />
    </endButton>
    </Dialog>
</core:FragmentDefinition>