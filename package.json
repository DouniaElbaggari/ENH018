{
  "name": "Sales Order Manage",
  "version": "0.0.1",
  "description": "An SAP Fiori application.",
  "keywords": [
    "ui5",
    "openui5",
    "sapui5"
  ],
  "main": "webapp/index.html",
  "devDependencies": {
    "@sap-ux/backend-proxy-middleware": "^1.0.21",
    "@sap-ux/eslint-plugin-fiori-tools": "^10.18.2",
    "@sap-ux/ui5-proxy-middleware": "^2.0.16",
    "@sap/ux-ui5-tooling": "^1.34.0",
    "@sapui5/types": "~1.154.0",
    "@ui5/cli": "^4.0.73",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "rimraf": "^6.1.4",
    "typescript": "^7.0.2",
    "ui5-middleware-simpleproxy": "^3.9.0",
    "ui5-tooling-transpile": "^3.14.1"
  },
  "scripts": {
    "start": "fiori run --open \"test/flp.html#app-preview\"",
    "start-local-old": "fiori run --config ./ui5-local.yaml --open \"test/flp.html#app-preview\"",
    "start-local": "cross-env NODE_EXTRA_CA_CERTS=C:\\Users\\NeilGardiner\\Documents\\Certificates\\sap-ca.pem fiori run --config ./ui5-local.yaml --open \"test/flp.html#app-preview\"",
    "build": "ui5 build --config=ui5.yaml --clean-dest --dest dist",
    "lint": "eslint ./",
    "ts-typecheck": "tsc --noEmit",
    "prestart": "npm run ts-typecheck",
    "deploy": "npm run build && fiori deploy --config ui5-deploy.yaml",
    "deploy:ignore-errors": "npm run deploy || true",
    "deploy-config": "fiori add deploy-config",
    "start-noflp": "fiori run --open \"/index.html?sap-ui-xx-viewCache=false\"",
    "int-test": "fiori run --open \"test/integration/opaTests.qunit.html\"",
    "start-variants-management": "fiori run --open \"/preview.html#app-preview\"",
    "unit-test": "fiori run --open \"test/unit/unitTests.qunit.html\"",
    "undeploy": "npm run build && fiori undeploy --config ui5-deploy.yaml",
    "deploy-test": "npm run build && fiori deploy --config ui5-deploy.yaml --testMode true"
  },
  "sapuxLayer": "CUSTOMER_BASE",
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-errors": "^3.0.0",
    "pnpm": "^12.18.0",
    "typescript-eslint": "8.72.1"
  }
}